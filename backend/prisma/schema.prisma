model LaundryHoliday {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  laundryId String   @map("laundry_id") @db.Uuid
  date      DateTime @db.Date
  reason    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  laundry   Laundry  @relation(fields: [laundryId], references: [id], onDelete: Cascade)

  @@unique([laundryId, date], map: "idx_laundry_holiday_unique")
  @@map("laundry_holidays")
}
